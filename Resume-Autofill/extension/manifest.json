{
  "manifest_version": 3,
  "name": "Resume AutoFill (AI)",
  "version": "1.0.0",
  "description": "Upload your resume once. AI fills job application forms for you on any site.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://YOUR-DEPLOYMENT.vercel.app/*", "<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
